{
  "name": "bimpack",
  "version": "1.0.0",
  "description": "BIM GLB 处理工具链：版本修正 → Draco 压缩 → 属性/几何校验 → 传输层预压缩 → three.js viewer",
  "type": "module",
  "bin": {
    "bimpack": "src/cli.mjs"
  },
  "scripts": {
    "inspect": "node src/cli.mjs inspect",
    "build": "node src/cli.mjs build",
    "verify": "node src/cli.mjs verify",
    "serve": "node src/cli.mjs serve",
    "test": "node test/batch.test.mjs",
    "start": "node start.mjs",
    "stop": "node stop.mjs --scan",
    "restart": "node stop.mjs --scan && node start.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "draco3dgltf": "^1.5.7",
    "three": "^0.170.0"
  }
}
