{
  "name": "bimpack",
  "version": "1.0.0",
  "description": "BIM GLB 处理工具链：前端预览/压缩（web/）+ 命令行 Draco 压缩与属性校验（src/）",
  "type": "module",
  "bin": {
    "bimpack": "src/cli.mjs"
  },
  "scripts": {
    "inspect": "node src/cli.mjs inspect",
    "build": "node src/cli.mjs build",
    "verify": "node src/cli.mjs verify",
    "test": "node test/batch.test.mjs",
    "dev": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "preview:web": "npm --prefix web run preview"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "draco3dgltf": "^1.5.7",
    "three": "^0.170.0"
  }
}
